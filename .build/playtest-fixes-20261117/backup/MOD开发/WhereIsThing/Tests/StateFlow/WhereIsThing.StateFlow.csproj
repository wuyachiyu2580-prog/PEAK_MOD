<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Extracted private record fields intentionally have partial initialization in test doubles. -->
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GameStubs.cs" />
    <Compile Include="GameRuntimeStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(IntermediateOutputPath)ProductionFragments.cs" />
    <Compile Include="../../WhereIsThing/WhereIsThingPlugin.State.cs" />
    <Compile Include="../../WhereIsThing/ThingTypes.cs" />
    <Compile Include="../../WhereIsThing/ThingNapberry.cs" />
    <Compile Include="../../WhereIsThing/WhereIsThingPlugin.Napberry.cs" />
    <Compile Include="../../WhereIsThing/ThingPresetSelection.cs" />
    <Compile Include="../../WhereIsThing/ThingItemTraits.cs" />
    <Compile Include="../../WhereIsThing/ThingLabelRange.cs" />
    <Compile Include="../../WhereIsThing/ThingPickupIdentity.cs" />
    <Compile Include="../../WhereIsThing/ThingSegmentFilter.cs" />
    <Compile Include="../../WhereIsThing/ThingPresets.cs" />
    <Compile Include="../../WhereIsThing/Helpers/ThingUi.cs" />
    <Compile Include="../../WhereIsThing/WhereIsThingPlugin.Plants.cs" />
    <Compile Include="../../WhereIsThing/WhereIsThingPlugin.Luggage.cs" />
  </ItemGroup>
  <Target Name="ExtractCurrentProductionMethods" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)ExtractProduction.ps1&quot; -Destination &quot;$(MSBuildThisFileDirectory)$(IntermediateOutputPath)ProductionFragments.cs&quot;" />
  </Target>
</Project>
